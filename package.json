{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo dev",
    "codegen": "turbo codegen",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test:e2e": "e2e run",
    "test:e2e:ci": "e2e run --strict-cache",
    "docs:pull": "sh scripts/pull-docs.sh"
  },
  "devDependencies": {
    "@adonisjs/eslint-plugin": "^2.2.2",
    "@ai-sdk/anthropic": "^4.0.80",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@e2e-dev/web": "^0.15.1",
    "@julr/tooling-configs": "^6.1.2",
    "@shadcn/lint": "^0.2.1",
    "@types/node": "~26.6.5",
    "ai": "^7.0.0",
    "e2e": "^0.21.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "turbo": "^2.11.3",
    "zod": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}

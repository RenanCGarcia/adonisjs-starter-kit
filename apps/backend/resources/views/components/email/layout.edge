{{--
  Shared chrome for every transactional mail: fonts, colors, and the card frame.
  Callers fill `main` with their own <mj-section> blocks.
--}}
@mjml({ fonts: { Inter: 'https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700' } })
  <mjml lang="{{ $props.get('lang', 'en') }}">
    <mj-head>
      <mj-title>{{ $props.get('title', '') }}</mj-title>
      <mj-preview>{{ $props.get('preview', '') }}</mj-preview>
      <mj-attributes>
        <mj-all font-family="Inter, system-ui, -apple-system, Helvetica, Arial, sans-serif" />
        <mj-text color="#09090b" font-size="15px" line-height="1.6" />
      </mj-attributes>
      <mj-style>
        .card { border: 1px solid #e4e4e7; border-radius: 10px; }
      </mj-style>
    </mj-head>
    <mj-body background-color="#f4f4f5" width="600px">
      <mj-section padding="32px 16px 16px">
        <mj-column>
          <mj-text align="center" font-size="14px" font-weight="700" color="#71717a">
            {{ $props.get('appName') }}
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-wrapper css-class="card" background-color="#ffffff" border-radius="10px" padding="32px">
        {{{ await $slots.main() }}}
      </mj-wrapper>
      <mj-section padding="20px 16px 32px">
        <mj-column>
          <mj-text align="center" font-size="12px" color="#71717a">
            {{ $props.get('footer', '') }}
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-body>
  </mjml>
@end

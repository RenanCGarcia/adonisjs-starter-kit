{{!-- One migrations folder for every module: a <module>/ prefix (from make:model -m) only names the table. --}}
{{{
  exports({
    to: app.makePath(migration.folder, migration.fileName)
  })
}}}
import { BaseSchema } from '@adonisjs/lucid/schema'


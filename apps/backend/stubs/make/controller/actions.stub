{{#var module = entity.path !== './' && process.getBuiltinModule('node:fs').existsSync(app.makePath('app', entity.path)) ? entity.path : new Function("throw new Error('The name must start with an existing module: <module>/<name>, e.g. users/tokens. New modules come from node ace make:module.')")()}}
{{#var controllerName = generators.controllerName(entity.name, singular)}}
{{#var controllerFileName = generators.controllerFileName(entity.name, singular)}}
{{{
  exports({
    to: app.makePath('app', module, 'controllers', controllerFileName)
  })
}}}
import type { HttpContext } from '@adonisjs/core/http'

export default class {{ controllerName }} {
  {{#each actions as action}}
  async {{action}}(_ctx: HttpContext) {}
  {{/each}}
}
